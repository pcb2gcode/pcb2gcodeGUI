    "al-setzzero": {"label": "Set Z zero G-code", "enabled_if": "(al-front || al-back) && software == 'custom'"},

    "optimise": {"label": "Path simplification", "fine": true, "min": "0"},
    "eulerian-paths": {"label": "Eulerian paths (don't mill a path twice)"},
