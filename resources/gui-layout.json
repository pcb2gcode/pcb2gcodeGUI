    "backtrack": {"label": "Backtrack limit", "per_second": true, "preset": "5in/s"},

    "ignore-warnings": {"label": "Treat option errors as warnings"},
    "sanity-checks": {"label": "Run sanity checks"},
    "single-thread": {"label": "Single thread"}
