    "zbridges": {"label": "Bridge height", "preset": "-0.6mm", "enabled_if": "bridges"},

    "al-front": {"label": "Autolevel the front side"},
    "al-back": {"label": "Autolevel the back side"},
    "software": {"label": "Machine software", "choice_labels": {"linuxcnc": "LinuxCNC", "mach3": "Mach3", "mach4": "Mach4", "custom": "Custom"}},
    "al-x": {"label": "Probe spacing in X", "enabled_if": "al-front || al-back"},
